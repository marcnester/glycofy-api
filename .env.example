ENV=development
DEBUG=true
PUBLIC_BASE_URL=http://127.0.0.1:8090
DATABASE_URL=sqlite:///./glycofy.db

# Generate secrets; never copy these placeholder values into production.
JWT_SECRET=replace-with-at-least-32-random-characters
OAUTH_TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key
COOKIE_SECURE=false

ALLOWED_ORIGINS=http://127.0.0.1:8090,http://localhost:8090
ALLOWED_HOSTS=127.0.0.1,localhost
ENABLE_DEV_ROUTES=false
MAX_REQUEST_BODY_BYTES=1048576
AUTH_RATE_LIMIT_PER_15_MINUTES=20
SECURITY_AUDIT_RETENTION_DAYS=365
SECURITY_ALERT_EMAIL_TO=security@example.com
SECURITY_ALERT_EMAIL_ENABLED=false
SECURITY_ALERT_EMAIL_COOLDOWN_SECONDS=900
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://127.0.0.1:8090/oauth/strava/callback
STRAVA_WEBHOOK_VERIFY_TOKEN=
STRAVA_WEBHOOK_SUBSCRIPTION_ID=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8090/oauth/google/callback

# AI meal recommendations
OPENAI_API_KEY=

# Instacart Developer Platform (optional; CTA stays hidden without a key)
INSTACART_API_KEY=
INSTACART_API_BASE=https://connect.instacart.com
INSTACART_LINK_EXPIRES_DAYS=30

# TrainingPeaks approved-partner credentials (CSV import remains available)
TRAININGPEAKS_CLIENT_ID=
TRAININGPEAKS_CLIENT_SECRET=
TRAININGPEAKS_REDIRECT_URI=http://127.0.0.1:8090/oauth/trainingpeaks/callback
